# Edge Function secrets for online payments (FIB and card). Names only: never commit real values.
# Fill the values in, then paste all the lines at once into Supabase → Edge Functions → Secrets
# ("Insert or update multiple secrets at once by pasting key-value pairs") and press Save.
# Sandbox first. Switch to the production values (fib.prod.fib.iq / prodswitch.fib.iq) only after a
# sandbox payment with each method has worked. BACKEND.md "Apps: online payments".

# FIB online (app / QR): from FIB's business portal, Online payments → credentials.
FIB_BASE_URL=https://fib.stage.fib.iq
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=

# FIB card gateway: merchant portal → Terminal List → the ecommerce terminal → credentials (Test view).
FIB_CARD_BASE_URL=https://uatswitch.fib.iq/ACS24
FIB_CARD_TERMINAL_NUMBER=
FIB_CARD_INSTITUTION=
FIB_CARD_MERCHANT_ID=
FIB_CARD_ACQUIRER=
FIB_CARD_HMAC_SECRET=

# Optional: the terminal's clock zone (default Asia/Baghdad) and where the bank's card page returns
# (default: the app-card-return function, which opens the app).
# FIB_CARD_DATETIME_TZ=Asia/Baghdad
# FIB_CARD_RETURN_URL=
